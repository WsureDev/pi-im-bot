{
  "reply": {
    "type": "object",
    "description": "回复样式",
    "items": {
      "prefix": {
        "type": "string",
        "description": "文字前缀",
        "hint": "可以为不同群设置不同前缀。",
        "default": "收到：",
        "scope": ["instance", "account", "room", "conversation"]
      },
      "uppercase": {
        "type": "bool",
        "description": "英文转为大写",
        "default": false,
        "scope": ["instance", "room"]
      }
    }
  }
}
