{
  "service": {
    "type": "string",
    "description": "语音合成服务",
    "hint": "从已登记服务中选择。这里只绑定引用，不在插件配置里重复填写 API Key。",
    "default": "",
    "options": ["", "gsvi-home"],
    "labels": ["请选择服务", "家中的 GSVI（示例服务）"],
    "scope": ["instance"]
  },
  "playback": {
    "type": "object",
    "description": "声音与表达",
    "hint": "这些偏好可以按群覆盖，所有成员共享当前群的选择。",
    "items": {
      "voice": {
        "type": "string",
        "description": "音色",
        "options": ["花火", "三月七", "英语旁白"],
        "default": "花火",
        "scope": ["instance", "account", "room", "conversation"]
      },
      "text_lang": {
        "type": "string",
        "description": "语言",
        "options": ["中文", "英语", "日语"],
        "default": "中文",
        "scope": ["instance", "account", "room", "conversation"]
      },
      "max_chars": {
        "type": "int",
        "description": "最多朗读字数",
        "hint": "超过限制时保留文字。",
        "default": 100,
        "slider": { "min": 20, "max": 500, "step": 10 },
        "scope": ["instance", "account", "room", "conversation"]
      },
      "probability": {
        "type": "int",
        "description": "触发概率（%）",
        "default": 100,
        "slider": { "min": 0, "max": 100, "step": 1 },
        "scope": ["instance", "account", "room", "conversation"]
      }
    }
  },
  "delivery": {
    "type": "object",
    "description": "交付方式",
    "items": {
      "mode": {
        "type": "string",
        "description": "发送内容",
        "options": ["audio", "both"],
        "labels": ["仅语音", "文字和语音"],
        "default": "audio",
        "scope": ["instance", "room"]
      },
      "fallback_text": {
        "type": "bool",
        "description": "合成失败时发送文字",
        "default": true,
        "scope": ["instance", "room"]
      },
      "timeout_seconds": {
        "type": "int",
        "description": "合成等待上限（秒）",
        "hint": "实际时间仍受整个呈现阶段剩余预算限制。",
        "default": 10,
        "slider": { "min": 1, "max": 15, "step": 1 },
        "scope": ["instance"]
      }
    }
  }
}
