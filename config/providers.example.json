{
  "defaultGroup": "main",
  "providers": [
    {
      "id": "primary",
      "enabled": false,
      "protocol": "openai-responses",
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "",
      "headers": {},
      "body": { "store": false, "service_tier": "auto" },
      "timeoutMs": 120000,
      "models": [
        {
          "id": "your-primary-model",
          "contextWindow": 128000,
          "maxOutputTokens": 16384,
