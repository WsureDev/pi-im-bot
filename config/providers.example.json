      "body": { "store": false },
      "timeoutMs": 120000,
      "models": [
        {
          "id": "your-backup-model",
          "contextWindow": 128000,
          "maxOutputTokens": 16384,
          "reasoning": true,
          "images": true,
          "body": { "reasoning": { "effort": "low" } }
        }
      ]
    }
  ],
  "groups": [
    {
      "id": "main",
      "name": "主模型组",
