          "images": true,
          "headers": {},
          "body": { "reasoning": { "effort": "medium" } }
        }
      ]
    },
    {
      "id": "backup",
      "enabled": false,
      "protocol": "openai-responses",
      "baseUrl": "https://your-compatible-provider.example/v1",
      "apiKey": "",
