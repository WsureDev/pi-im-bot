{
  "backend": {
    "type": "string",
    "description": "图像 MCP 服务",
    "_special": "select_mcp",
    "hint": "选择已经配置的图像服务，凭据保留在 Bot。",
    "default": "image-gateway",
    "scope": ["instance"]
  },
  "result": {
    "type": "object",
    "description": "结果与反馈",
    "items": {
      "notify_started": {
        "type": "bool",
        "description": "提交后告知任务已开始",
        "default": true,
        "scope": ["instance", "room"]
      },
      "default_preset": {
        "type": "string",
        "description": "默认预设",
        "default": "日常插画",
        "scope": ["instance", "account", "room", "conversation"]
      }
    }
  },
  "presets": {
    "type": "template_list",
    "description": "绘图预设",
    "hint": "选择模板添加预设。每个预设可命名、修改或删除。",
    "default": [
      {
        "__template_key": "illustration",
        "name": "日常插画",
        "prompt_prefix": "自然光，干净的构图",
        "aspect": "1:1"
      }
    ],
    "templates": {
      "illustration": {
        "name": "插画预设",
        "display_item": "name",
        "items": {
          "name": { "type": "string", "description": "预设名称", "default": "新的插画预设" },
          "prompt_prefix": { "type": "text", "description": "提示词前缀", "default": "" },
          "aspect": {
            "type": "string",
            "description": "宽高比",
            "options": ["1:1", "16:9", "9:16"],
            "default": "1:1"
          }
        }
      },
      "workflow": {
        "name": "工作流预设",
        "display_item": "name",
        "items": {
          "name": { "type": "string", "description": "预设名称", "default": "新的工作流预设" },
          "workflow": { "type": "string", "description": "工作流名称", "default": "" },
          "prompt_prefix": { "type": "text", "description": "提示词前缀", "default": "" }
        }
      }
    },
    "scope": ["instance", "room"]
  }
}
