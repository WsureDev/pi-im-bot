{
  "automatic": {
    "type": "object",
    "description": "自动撤回",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "撤回 Bot 的回复",
        "default": true,
        "scope": ["instance", "account", "room", "conversation"]
      },
      "delay_seconds": {
        "type": "int",
        "description": "发送后等待（秒）",
        "default": 180,
        "slider": { "min": 10, "max": 600, "step": 10 },
        "condition": { "enabled": true },
        "scope": ["instance", "account", "room", "conversation"]
      },
      "media_only": {
        "type": "bool",
        "description": "仅撤回含媒体的回复",
        "default": false,
        "condition": { "enabled": true },
        "scope": ["instance", "room"]
      }
    }
  },
  "manual": {
    "type": "object",
    "description": "手动指令",
    "hint": "工具权限由 Bot 统一管理，这里的开关不授予成员额外权限。",
    "items": {
      "max_batch": {
        "type": "int",
        "description": "每次最多撤回条数",
        "default": 20,
        "slider": { "min": 1, "max": 50, "step": 1 },
        "scope": ["instance", "room"]
      },
      "notify": {
        "type": "bool",
        "description": "显示操作结果",
        "default": true,
        "scope": ["instance", "room"]
      }
    }
  }
}
